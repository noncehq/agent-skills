{
  "name": "@nonce-skill/nonce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./assets/tool-signatures.ts",
      "import": "./scripts/skill-runtime.js"
    },
    "./runtime": {
      "types": "./assets/tool-signatures.ts",
      "import": "./scripts/skill-runtime.js"
    }
