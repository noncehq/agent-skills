{
  "schemaVersion": 1,
  "skill": "nonce",
  "description": "Natural-language prompt and behavior cases for the packaged Nonce Codex skill.",
  "runsPerCase": 3,
  "thresholds": {
    "minimumOverallAccuracy": 0.9,
    "minimumPositiveRecall": 0.9,
    "minimumNegativeSpecificity": 0.9,
    "criticalFailuresAllowed": 0
  },
  "cases": [
    {
      "id": "trigger.zh.workspace.list",
      "split": "train",
      "category": "trigger.read.workspace",
      "language": "zh",
      "query": "我在 Nonce 账号里现在能看到哪些工作区？",
      "expected": {
        "trigger": true,
        "critical": true,
        "methods": ["listWorkspaces"],
        "mustRead": ["references/workflow.md", "references/tool-signatures.md"],
        "schemaFiles": ["assets/schemas/list-workspaces.md"],
        "destructive": false,
        "requiresConfirmation": false
      }
    },
    {
      "id": "trigger.zh.farm.offline-miners",
      "split": "train",
      "category": "trigger.read.miners",
      "language": "zh",
      "query": "帮我看看这个矿场里最近有哪些矿机掉线了。",
      "expected": {
        "trigger": true,
        "critical": true,
        "methods": ["listWorkspaces", "listFarms", ["listMiners", "searchMiners"]],
        "mustRead": ["references/workflow.md", "references/tool-signatures.md"],
        "schemaFiles": [
          "assets/schemas/list-workspaces.md",
          "assets/schemas/list-farms.md",
          ["assets/schemas/list-miners.md", "assets/schemas/search-miners.md"]
        ],
        "destructive": false,
        "requiresConfirmation": false
      }
    },
    {
