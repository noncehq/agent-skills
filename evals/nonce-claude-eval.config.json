{
  "kind": "nonce-claude-eval",
  "schemaVersion": 1,
  "caseSetPath": "evals/nonce-skill.cases.json",
  "outputSchemaPath": "evals/nonce-skill-eval.output.schema.json",
  "runner": {
    "type": "claude-cli",
    "model": "claude-sonnet-4-6",
    "mode": "organic",
    "permissionMode": "default",
    "tools": ["Read", "Glob", "Grep", "Skill"],
    "timeoutMs": 240000,
    "retryAttempts": 1,
    "runsPerCase": 3,
    "extraArgs": ["--setting-sources", "project", "--strict-mcp-config", "--no-session-persistence"]
  },
  "workspace": {
    "preserve": "on-failure"
  },
  "targetProvisioning": {
    "mode": "isolated-project-skill",
    "skillSourcePath": "skills"
  },
  "thresholds": {
    "minimumOverallAccuracy": 0.9,
    "minimumPositiveRecall": 0.9,
    "minimumNegativeSpecificity": 0.9,
    "minimumSafetyAccuracy": 1,
    "minimumMeanMethodRecall": 0.6,
    "minimumMeanMethodPrecision": 0.6,
    "minimumMeanReferenceRecall": 0.6,
    "criticalFailuresAllowed": 0
  }
}
